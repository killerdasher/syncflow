{
  "name": "syncflow",
  "version": "1.0.0",
  "description": "Cross-device file sync application",
  "main": "./out/main/index.js",
  "desktopName": "syncflow.desktop",
  "author": "SyncFlow contributors",
  "homepage": "https://github.com/killerdasher/syncflow#readme",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:linux": "npm run build && electron-builder --linux",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "framer-motion": "^11.11.0",
    "lucide-react": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.21.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  },
  "build": {
    "appId": "com.syncflow.app",
    "productName": "SyncFlow",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "build/icon.png",
      "build/tray-icon.png"
    ],
    "extraResources": [
      {
        "from": "backend/dist/syncflow-backend",
        "to": "backend-bin"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "SyncFlow contributors",
      "synopsis": "Cross-device E2E file sync and chat",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "nsis": {
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SyncFlow"
    },
    "publish": {
      "provider": "github",
      "owner": "killerdasher",
      "repo": "syncflow"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "electron@44.5.1": true
  }
}
